# Copy to .env for local dev. On Vercel, set these in Project Settings > Environment Variables.
# Everything is optional: with nothing set the app runs on in-memory demo data and local models.

# MongoDB Atlas connection string. Leave empty to use the in-memory store.
MONGODB_URI=
MONGODB_DB=smartresolve

# Hugging Face access token (read scope is enough). Enables the hosted
# sentiment and zero-shot models; without it the local models are used.
HF_TOKEN=
HF_TIMEOUT_MS=3500

# Session signing secret. REQUIRED for any public deploy. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Set to "off" to remove the one-click demo sign-in buttons' backend.
DEMO_LOGIN=
